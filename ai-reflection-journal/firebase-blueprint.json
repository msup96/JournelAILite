{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and reflection preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "currentStreak": { "type": "number" },
        "lastEntryDate": { "type": "string", "maxLength": 30 },
        "lastEntryTimestamp": { "type": "number" },
        "themePreference": { "type": "string", "enum": ["light", "dark", "system"] },
        "reflectionFocus": { "type": "string", "maxLength": 100 },
        "emailRemindersEnabled": { "type": "boolean" },
        "reminderTime": { "type": "string", "maxLength": 10 },
        "reminderTimezone": { "type": "string", "maxLength": 50 },
        "lastReminderSentAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "ReminderLog": {
      "title": "ReminderLog",
      "description": "Log of automated daily reminder emails scheduled and dispatched",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "maxLength": 150 },
        "sentAt": { "type": "string", "format": "date-time" },
        "hoursSinceLastEntry": { "type": "number" },
        "streakAtTime": { "type": "number" },
        "promptIncluded": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["delivered", "queued", "skipped"] },
        "reason": { "type": "string", "maxLength": 500 },
        "deliveryMethod": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "userEmail", "sentAt", "status"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "A private reflection journal entry written by the authenticated user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 15000 },
        "mood": { "type": "string", "maxLength": 30 },
        "moodScore": { "type": "number" },
        "tags": { "type": "array" },
        "isFavorite": { "type": "boolean" },
        "aiSummary": { "type": "string", "maxLength": 2000 },
        "aiInsights": { "type": "string", "maxLength": 5000 },
        "aiQuestions": { "type": "string", "maxLength": 2000 },
        "audioTranscript": { "type": "string", "maxLength": 15000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "content", "mood"]
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Public health probe document to test Firestore connectivity",
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/test/{testId}": {
      "schema": "ConnectionTest",
      "description": "Public probe document for testing Firestore server connectivity"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user account profile and streak statistics"
    },
    "/users/{userId}/reminder_logs/{logId}": {
      "schema": "ReminderLog",
      "description": "Historical log of automated daily reminder emails sent to this user"
    },
    "/entries/{entryId}": {
      "schema": "JournalEntry",
      "description": "Private reflection journal entries owned strictly by the author"
    }
  }
}
